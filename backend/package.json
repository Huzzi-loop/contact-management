{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "CRM Contact Workspace - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
